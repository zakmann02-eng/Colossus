# ── Telegram ──────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Wallets to watch (pre-configured) ─────────────────────────────────────────
# Comma-separated list of wallet addresses to monitor
WATCHED_WALLETS=0x2005d16a84ceefa912d4e380cd32e7ff827875ea,0x751a2b86cab503496efd325c8344e10159349ea1

# Optional: friendly labels for each wallet (same order, comma-separated)
WALLET_LABELS=ColossusRN,ColossusShark

# Optional: Polymarket usernames to watch (resolved to addresses on startup)
WATCHED_USERNAMES=

# ── Polling ────────────────────────────────────────────────────────────────────
# How often to check for new trades (seconds)
POLL_INTERVAL=30

# ── Copy-trade thresholds ──────────────────────────────────────────────────────
# Minimum win rate for a CONSIDER/STRONG BUY recommendation (0–1)
COPY_TRADE_MIN_WIN_RATE=0.55
# Minimum total volume traded ($) for a recommendation
COPY_TRADE_MIN_VOLUME=10000
