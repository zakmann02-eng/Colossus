# -- Telegram ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -- Polymarket API (from polymarket.us/developer) ----------------------------
# Set these in Railway Variables ONLY -- never commit
POLYMARKET_API_KEY=your_key_id_here
POLYMARKET_API_SECRET=your_secret_key_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here

# -- Trading limits -----------------------------------------------------------
MAX_TRADE_USD=2.00
TAKE_PROFIT_PCT=10.0
STOP_LOSS_PCT=10.0

# -- Scanning -----------------------------------------------------------------
SCAN_INTERVAL=60

# -- Pause switch -------------------------------------------------------------
PAUSED=false
