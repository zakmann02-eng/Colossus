# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Polymarket ─────────────────────────────────────────────────────────────────
# Your Polymarket private key — set this in Railway Variables ONLY, never commit
POLYMARKET_PRIVATE_KEY=

# ── Trading limits ─────────────────────────────────────────────────────────────
MAX_TRADE_USD=2.00
TAKE_PROFIT_PCT=10.0
STOP_LOSS_PCT=10.0

# ── Scanning ───────────────────────────────────────────────────────────────────
SCAN_INTERVAL=60

# ── Pause switch ──────────────────────────────────────────────────────────────
PAUSED=false
