# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Wallet to track ───────────────────────────────────────────────────────────
TRACKED_WALLET=
WALLET_LABEL=My Wallet

# ── Polling ────────────────────────────────────────────────────────────────────
POLL_INTERVAL=30

# ── Filters ───────────────────────────────────────────────────────────────────
MIN_TRADE_SIZE_USD=10

# ── Pause switch ──────────────────────────────────────────────────────────────
# Set to true in Railway Variables to suspend all monitoring instantly
PAUSED=false
